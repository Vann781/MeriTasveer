NODE_ENV=development

PORT=5000

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=./data/photo_finder.db

# --- Google Drive (backend only — never expose these to the frontend) ---
# Path to the service account JSON key. Put the file in backend/credentials/
# (gitignored) and share the Drive root folder with the service account email
# as "Viewer".
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# Alternative to the file above, for hosts where you cannot upload one:
# paste the whole JSON key as a single-line value. Takes precedence.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# The Drive folder that contains one subfolder per event (e.g. "MechQuish Photos").
# Copy it from the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Google Sign-In for participants (Phase 7 — not used yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Comma-separated list of organizer emails allowed into the admin area
ADMIN_EMAILS=

# --- Face recognition ---
# "large" (accurate, needs ~1 GB of RAM) or "small" (a tenth of the size, and
# measurably worse on small faces). Recalibrate the threshold if you change it.
FACE_MODEL=large

# Where the downloaded ONNX models live. Point this at a mounted disk in
# production so a redeploy does not re-download them.
# MODELS_DIR=./models

# --- Face matching ---
# Cosine similarity between two ArcFace embeddings: 1.0 is the same face,
# around 0 is unrelated. Measured on real event photos: different people score
# below 0.30, and a confirmed true match on a small blurry face scored 0.47,
# so 0.40 sits in the gap with room on both sides.
# Raise it to reduce false matches, lower it to catch more photos.
# Re-check with: npm run calibrate
FACE_MATCH_THRESHOLD=0.40

SESSION_SECRET=

# How long a participant can view the photos their search found, in minutes.
SEARCH_SESSION_TTL_MINUTES=120
